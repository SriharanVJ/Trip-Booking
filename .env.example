# ============================================================================
# Unified app — environment template
#
# Copy to `.env` at the repository root and fill in real values. `.env` is
# gitignored — NEVER commit real credentials. Both backend modules (travels
# and driver) and the seed scripts read this single file.
# ============================================================================

# ---------------------------------------------------------------------------
# Travels backend (services/api/travels_api, mounted at /api/v1)
# ---------------------------------------------------------------------------
# PostgreSQL (asyncpg driver). Local default shown.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vehicle_booking
# Auth/token signing
SECRET_KEY=change-me-random-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins allowed by CORS (frontend dev origin included)
BACKEND_CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Driver backend (services/api/driver_api, mounted at /api, plus /ws)
# ---------------------------------------------------------------------------
DRIVER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/acting_driver
JWT_SECRET=change-me-random-hex
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=http://localhost:8080

# Seeded admin account (phone identifies the account, email receives OTPs)
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# OTP delivery: "email" (SMTP) or "twilio" (SMS verify)
OTP_PROVIDER=email
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
# email provider never echoes codes; leave false
OTP_ECHO_IN_RESPONSE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace@example.com
SMTP_FROM_ADDRESS=replace@example.com
SMTP_PASSWORD=change-me-app-password

# Only needed when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Driver/ride matching tuning (safe defaults)
MATCHING_INITIAL_RADIUS_KM=5
MATCHING_RADIUS_STEP_KM=2
MATCHING_MAX_RADIUS_KM=25
MATCHING_REQUEST_TIMEOUT_SECONDS=30
MATCHING_MAX_ATTEMPTS=3
MATCHING_BATCH_SIZE=10

# Distance/fare estimation: "mock" or a real provider
DISTANCE_PROVIDER=mock
MOCK_ROAD_FACTOR=1.3
MOCK_AVG_SPEED_KMH=30

# Optional shared cache
REDIS_URL=

# Upload size cap (MB) for driver documents
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Frontend (Vite — only variables prefixed VITE_ reach client code)
# ---------------------------------------------------------------------------
# Origin of the unified FastAPI service in dev (vite proxies /api, /uploads,
# /ws to it). Leave unset to use the default http://localhost:8000.
VITE_API_ORIGIN=http://localhost:8000
# Base URL the travels frontend calls. Defaults to same-origin /api/v1 (the
# dev proxy handles it); only set when pointing at a different host.
# VITE_TRAVELS_API_URL=/api/v1
